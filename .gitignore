/target
/vendor/*.so
/vendor/*.so.*

__pycache__/
*.py[cod]

# Modèles copiés : binaires locaux, manifeste versionné.
/assets/models/*
!/assets/models/README.md
!/assets/models/manifest.toml
!/assets/models/qa/
/assets/models/qa/*
!/assets/models/qa/manifest.toml
!/assets/models/qa/dinov2_logo_probe.json
!/assets/models/qa/source_logos.toml

# Banque centrale d'overlays de mission A7 : les .mov (2,2 Go) restent locaux.
# Les PNG, le manifeste et le README sont versionnés.
/assets/mission_overlays/*.mov

# Corpus de parité : médias dérivés de productions et sorties volumineuses.
/parity/cases/*
!/parity/cases/corpus.lock.json
/parity/work/
/parity/baseline/
/parity/fixtures/*
!/parity/fixtures/README.md
!/parity/fixtures/checksums.json

# Données d’exécution locales (logs, archives, bases).
/runtime/

# Secrets locaux du lanceur Rust (générés au premier démarrage).
/config/launcher.env
