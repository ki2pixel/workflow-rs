/target
/vendor/*.so
/vendor/*.so.*

__pycache__/
*.py[cod]

# Modèles copiés : binaires locaux, manifeste versionné.
/assets/models/*
!/assets/models/README.md
!/assets/models/manifest.toml

# Corpus de parité : médias dérivés de productions et sorties volumineuses.
/parity/cases/*
!/parity/cases/corpus.lock.json
/parity/work/
/parity/baseline/
/parity/fixtures/*
!/parity/fixtures/README.md
!/parity/fixtures/checksums.json

# Données d’exécution locales (logs, archives, bases).
/runtime/
