{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workflow Manager",
  "version": "0.1.0",
  "identifier": "org.workflow.desktop",
  "build": {
    "frontendDist": "http://127.0.0.1:5004/",
    "devUrl": "http://127.0.0.1:5004/"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Workflow Manager",
        "url": "http://127.0.0.1:5004/",
        "create": false,
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "visible": true,
        "focus": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "incognito": false,
        "devtools": false,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": false,
        "browserExtensionsEnabled": false,
        "useHttpsScheme": false,
        "proxyUrl": null,
        "backgroundColor": null,
        "windowEffects": null,
        "parent": null
      }
    ],
    "security": {
      "csp": null,
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": false,
      "assetProtocol": { "enable": false, "scope": [] },
      "pattern": { "use": "brownfield" }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  },
  "plugins": {}
}
